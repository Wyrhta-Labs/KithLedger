# Database — matches docker-compose.yml service credentials
POSTGRES_PASSWORD=<generate-a-strong-password>
DATABASE_URL=postgres://kith:<generate-a-strong-password>@localhost:5432/kithledger

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<generate-a-32-char-minimum-random-string>
ADMIN_PASSWORD=<generate-a-strong-password>

# Server
API_PORT=4002
JWT_TTL_SECONDS=604800

# CORS — set to your frontend origin in production (e.g. https://example.com)
# Default '*' is only suitable for local development
CORS_ORIGIN=*

# Database connection pool
DB_POOL_MAX=10

# Satellite identity — verifying Heorth-issued member tokens (optional AS A GROUP)
# Both present -> KithLedger accepts short-lived member tokens signed by Heorth
# and verified against its published PUBLIC keys; both absent (the default) ->
# unchanged behaviour. Nothing here is a secret: KithLedger only ever verifies
# and holds no signing key (ADR 0009).
# HEORTH_JWKS_URL=http://heorth:4000/.well-known/jwks.json
# SATELLITE_AUDIENCE=kithledger
# Expected issuer; optional within the group, defaults to `heorth`
# HEORTH_ISSUER=heorth
